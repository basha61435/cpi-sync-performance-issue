
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://releaseowl.com/s4hana/sd/salesorder" targetNamespace="http://releaseowl.com/s4hana/sd/salesorder">
   <xsd:complexType name="DT_SalesOrder_Create">
      <xsd:annotation>
         <xsd:documentation xml:lang="EN">
         Sales order header and items sent from webshop to S/4HANA (API_SALES_ORDER_SRV)
         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="SalesOrderType" type="xsd:string" />
         <xsd:element name="SalesOrganization" type="xsd:string" />
         <xsd:element name="SoldToParty" type="xsd:string" />
         <xsd:element name="PurchaseOrderByCustomer" type="xsd:string" />
         <xsd:element name="RequestedDeliveryDate" type="xsd:date" />
         <xsd:element name="TotalNetAmount" type="xsd:decimal" />
         <xsd:element name="TransactionCurrency" type="xsd:string" />
      </xsd:sequence>
   </xsd:complexType>
</xsd:schema>